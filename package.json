{
  "name": "ultra-confluence-mcp",
  "version": "1.0.0",
  "description": "Context-efficient MCP server for Confluence Cloud — trims API responses and offloads large bodies to disk so agents don't burn their context window on Confluence noise.",
  "type": "module",
  "bin": {
    "ultra-confluence-mcp": "./build/index.js",
    "confluence-mcp": "./build/index.js",
    "confluence-cli": "./build/cli/index.js"
  },
  "main": "./build/index.js",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "npm run build && node scripts/bench.mjs",
    "prepare": "npm run build",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js"
  },
  "keywords": [
    "mcp",
    "confluence",
    "atlassian",
    "model-context-protocol",
    "ai",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "marked": "^18.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
